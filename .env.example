# Neon Postgres. Use a branch per developer; `main` is production.
# https://console.neon.tech → project → Connection string (pooled)
DATABASE_URL="postgresql://user:password@ep-xxx-pooler.region.aws.neon.tech/shipshape?sslmode=require"

# 32+ random bytes, base64. Peppers the SHA-256 hash of magic-link tokens, so a
# leaked database cannot be brute-forced offline into working sign-in links.
# Changing it invalidates every unused link; sessions are unaffected.
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
SESSION_SECRET=""

# Where the app is reachable. Used in emails and absolute links.
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Transactional email (magic links, digests). Optional until auth email lands.
RESEND_API_KEY=""
SHIPSHAPE_FROM_EMAIL="Shipshape <no-reply@shipshape.northbound.studio>"
